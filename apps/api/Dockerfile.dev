# Build from the repository root (see docker-compose.yml). Dependencies are
# installed by the compose command into the bind-mounted workspace.
FROM node:24-alpine

WORKDIR /usr/src/app/apps/api

RUN corepack enable

EXPOSE 3000

CMD ["pnpm", "exec", "turbo", "run", "dev", "--filter=@mcdi/api", "--ui=stream"]
