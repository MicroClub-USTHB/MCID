<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MCID - Login</title>
    <link rel="icon" href="/assets/mcid-mark.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="container">
        <div class="login-card">
            <div class="logo-section">
                <svg class="logo-mark" viewBox="0 0 120 120" fill="none" stroke-width="12" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path class="mark-fg" d="M 38 100 A 22 22 0 0 1 16 78 V 60 A 44 44 0 0 1 104 60 V 78 A 22 22 0 0 1 82 100"/>
                    <path class="mark-primary" d="M 38 82 V 60 A 22 22 0 0 1 82 60 V 82"/>
                    <path class="mark-fg" d="M 60 56 V 100"/>
                </svg>
                <h1>MCID</h1>
                <p>Micro Club Identity</p>
            </div>

            <div class="content-section">
                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="status-message error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <h2>Authentication Failed</h2>
                        <p><%= typeof errorDescription !== 'undefined' && errorDescription ? errorDescription : 'Something went wrong. Please try again.' %></p>
                    </div>
                <% } else if (typeof serverId !== 'undefined' && serverId) { %>
                    <div class="login-actions">
                        <% if (typeof projectName !== 'undefined' && projectName) { %>
                            <p>Log in to <strong><%= projectName %></strong></p>
                        <% } else { %>
                            <p>Please log in to continue</p>
                        <% } %>
                        <a href="/api/auth/discord" class="btn-discord">
                            <i class="fa-brands fa-discord"></i> Login with Discord
                        </a>
                    </div>
                <% } else { %>
                    <div class="status-message error">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <h2>Invalid Login Link</h2>
                        <p>This page must be accessed via a valid login link from a registered platform.</p>
                    </div>
                <% } %>
            </div>

            <footer>
                <p>&copy; 2026 Micro Club</p>
            </footer>
        </div>
    </div>
</body>

</html>