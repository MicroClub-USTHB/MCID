# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
APP_PORT=3000
PORT=3000
# API_PREFIX=api

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
# Aligned with docker-compose.yml dev defaults.
# Production deployments override this via the deployment environment.
DATABASE_URL=postgresql://myuser:mypassword@database:5432/mcdi

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_KEY_PREFIX=mcdi
# REDIS_URL=redis://:redis_password@redis:6379

# ============================================
# CORS CONFIGURATION (Optional)
# ============================================
# Comma-separated list of allowed origins for the browser-facing API.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================
# CACHING & TTLs (Optional)
# ============================================
# PERMISSION_CACHE_TTL_MS, STATS_CACHE_TTL_MS, MEMBER_ACTIVITY_THRESHOLD_DAYS and
# MAX_WEBHOOKS_PER_PROJECT are the *defaults* for the runtime-editable settings
# exposed at PATCH /api/admin/settings. A stored override wins over the value
# here; POST /api/admin/settings/reset clears overrides back to these.
PERMISSION_CACHE_TTL_MS=300000
PROJECT_AUTH_CACHE_TTL_MS=30000
PROJECT_ACCESS_CACHE_TTL_MS=30000
PROJECT_LAST_USED_WRITE_TTL_MS=60000

# ============================================
# AUTHENTICATION TTLs (seconds, Optional)
# ============================================
AUTH_REQUEST_TTL_SEC=600
OAUTH_STATE_TTL_SEC=600
CALLBACK_CODE_TTL_SEC=120
SESSION_TTL_SEC=2592000

# ============================================
# SSO (Optional)
# ============================================
# Global browser session shared across MCDI projects.
# SSO_COOKIE_NAME=mcdi_sso
# SSO_COOKIE_DOMAIN=.microclub.example
# SSO_TTL_SEC=2592000

# ============================================
# WEBHOOK TOKEN ENCRYPTION
# ============================================
# Encrypts stored Discord webhook tokens at rest (AES-256-GCM).
# 64 hex characters. Generate with `openssl rand -hex 32`.
# Required in production. Never commit a real value.
WEBHOOK_ENCRYPTION_KEY=
MAX_WEBHOOKS_PER_PROJECT=10

# ============================================
# RATE LIMITING (Optional)
# ============================================
# Global throttler limits (requests per window). Tunable per environment.
THROTTLER_TTL_MS=60000
THROTTLER_LIMIT=120

# ============================================
# DISCORD CONFIGURATION (Required for OAuth)
# ============================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_TOKEN=your-discord-bot-token
# Required for member OAuth flow
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/discord/callback
# Required for admin OAuth flow
DISCORD_ADMIN_CALLBACK_URL=http://localhost:3000/api/auth/admin/discord/callback
# REQUIRED: main MCDI Discord server
MC_GUILD_ID=your-main-guild-id
# REQUIRED: Discord role ID that grants admin access in the main guild
MC_EXECUTIVE_ROLE_ID=your-executive-role-id
# OPTIONAL: Additional Discord role IDs that grant admin access
MC_DEV_LEADS_ROLE_ID=
MC_IT_LEADS_ROLE_ID=

# ============================================
# ADMIN PANEL
# ============================================
# Where the browser is redirected after a successful admin Discord OAuth2 login.
# The admin_session httpOnly cookie is set on this redirect.
ADMIN_FRONTEND_URL=http://localhost:5173

# ============================================
# PRODUCTION COMPOSE SECRETS
# ============================================
# Consumed by docker-compose.prod.yml (the API service reads these through
# DATABASE_URL / REDIS_PASSWORD; the database & redis services read POSTGRES_PASSWORD
# and REDIS_PASSWORD directly). Never commit real secrets — inject via the
# deployment environment (e.g. dokploy env).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# ==============================================================================
# INBOUND WEBHOOKS
# ==============================================================================
# A separate key from WEBHOOK_ENCRYPTION_KEY above (which encrypts stored
# Discord webhook tokens). This one encrypts inbound-webhook signing secrets.
# Same format: 64 hex characters.
# REQUIRED in production: boot fails if it is absent or malformed — signing
# secrets are encrypted at rest with this key, and a silent fallback to
# plaintext must not be possible.
#   openssl rand -hex 32
INBOUND_WEBHOOK_ENCRYPTION_KEY=

# Optional tuning
INBOUND_WEBHOOK_SIGNATURE_TOLERANCE_S=300
INBOUND_WEBHOOK_RATE_LIMIT=120
