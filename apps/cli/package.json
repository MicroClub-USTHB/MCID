{
  "name": "mcdi-cli",
  "version": "0.0.0",
  "description": "A developer CLI to authenticate against MCDI and manage Inbound Webhooks from the terminal",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcdi-cli": "./bin/mcdi-cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "class-validator": "^0.14.4",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
