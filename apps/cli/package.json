{
  "name": "@mcdi/cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "mcdi-cli: the MCDI admin CLI. Authenticates against MCDI and manages Inbound Webhooks from the terminal",
  "type": "module",
  "bin": {
    "mcdi-cli": "./bin/mcdi-cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ci": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.0",
    "class-validator": "^0.14.4",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@mcdi/eslint-config": "workspace:*",
    "@mcdi/typescript-config": "workspace:*",
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "9.39.4",
    "prettier": "^3.8.2",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.57.1",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=22"
  }
}
