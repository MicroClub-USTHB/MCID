{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "views/**/*",
      "public/**/*"
    ],
    "watchAssets": true,
    "plugins": ["@nestjs/swagger"]
  },
  "watchOptions": {
    "usePolling": true
  }
}