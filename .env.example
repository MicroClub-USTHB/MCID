# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=development
APP_PORT=3000
PORT=3000

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
# Note: These match the docker-compose.yml defaults
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres_password
DB_DATABASE=mcdi_pgdb

DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/mcdi_pgdb

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# ============================================
# MANAGEMENT UI PORTS
# ============================================
PGADMIN_PORT=8080
REDIS_COMMANDER_PORT=8081

# ============================================
# EMAIL TESTING (Mailhog)
# ============================================
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ============================================
# SECURITY & AUTH (Configure when needed)
# ============================================
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# JWT_EXPIRATION=7d

# ============================================
# API CONFIGURATION (Optional)
# ============================================
# API_PREFIX=api
# API_VERSION=v1

# ============================================
# CORS CONFIGURATION (Optional)
# ============================================
# CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# FILE UPLOAD (Optional)
# ============================================
# MAX_FILE_SIZE=10485760
# UPLOAD_DEST=./uploads

# ============================================
# DISCORD CONFIGURATION 
# ============================================
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=your-discord-bot-token
MC_GUILD_ID=your-guild-id