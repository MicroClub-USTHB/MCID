// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Member {
  id            String    @id @default(uuid())
  discordId     String    @unique
  discriminator String?
  globalName    String?
  isActive      Boolean   @default(true)
  email         String    @unique
  fullName      String?
  lastLoginAt   DateTime?
  avatar        String?
  joinDate      DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  secretData     secretData?
  refreshTokens  RefreshToken[]
  memberRoles    MemberRole[]
  memberLogs     MemberLog[]
  projectMembers ProjectMember[]
  sentMessages   MessageLog[]    @relation("SentByMember")
  syncStatuses   SyncStatus[]    @relation("MemberSync")

  @@map("members")
  @@index([discordId])
  @@index([email])
}

model secretData {
  phoneNumber     String?
  personalPicture String?
  age             Int?
  memberId        String   @id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("secret_data")
}

model Role {
  id             String   @id @default(uuid())
  discordRoleId  String   @unique
  name           String
  permissions    Json
  color          String
  position       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberRoles  MemberRole[]
  channelRoles ChannelRole[]
  syncStatuses SyncStatus[]  @relation("RoleSync")

  @@map("roles")
  @@index([discordRoleId])
}

model MemberRole {
  memberId   String
  roleId     String
  assignedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@map("member_roles")
}

model Channel {
  id               String      @id @default(uuid())
  discordChannelId String      @unique
  name             String
  topic            String?
  type             ChannelType @default(text)
  category         String?
  permissions      Json
  isPrivate        Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  channelRoles     ChannelRole[]
  webhooks         Webhook[]
  messageLogs      MessageLog[]
  syncStatuses     SyncStatus[]              @relation("ChannelSync")
  projectAllowedBy ProjectAllowedChannel[]

  @@map("channels")
  @@index([discordChannelId])
}

enum ChannelType {
  voice
  text
  announcement
  thread
}

model ChannelRole {
  roleId      String
  channelId   String
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  role    Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([roleId, channelId])
  @@map("channel_roles")
}

enum PermissionLevel {
  LOW
  MEDIUM
  HIGH
  ADMIN
}


model Project {
  id              String   @id @default(uuid())
  name            String
  description     String?
  permissionLevel PermissionLevel
  apiKeyHash      String?
  rateLimitRpm    Int      @default(60)
  webhookLimit    Int      @default(10)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  apiKeys         apiKey[]
  projectMembers  ProjectMember[]
  discordEvents   DiscordEvent[]
  messageLogs     MessageLog[]
  mcEvents        MCEvent[]
  syncStatuses    SyncStatus[]              @relation("ProjectSync")
  allowedChannels ProjectAllowedChannel[]

  @@map("projects")
}

model ProjectAllowedChannel {
  projectId String
  channelId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([projectId, channelId])
  @@map("project_allowed_channels")
}

model ProjectMember {
  memberId  String
  projectId String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([memberId, projectId])
  @@map("project_members")
}

model apiKey {
  id        String    @id @default(uuid())
  key       String    @unique
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  projectId String
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("api_keys")
  @@index([projectId])
}

model Webhook {
  discordWebhookId String    @id
  name             String
  avatar           String?
  webhookURL       String
  projectId        String
  createdBy        String
  channelId        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("webhooks")
  @@index([channelId])
}

model DiscordEvent {
  name                String
  type                String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  delivery            Boolean  @default(false)
  deliveryAttempts    Int      @default(0)
  projectSubscriberId String

  project Project @relation(fields: [projectSubscriberId], references: [id], onDelete: Cascade)

  @@id([name, projectSubscriberId])
  @@map("discord_events")
}

model MCEvent {
  name      String   @id
  eventType String
  eventDate DateTime
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("mc_events")
  @@index([projectId])
}

model logs {
  id         String   @id @default(uuid())
  actionType String
  action     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberLogs MemberLog[]

  @@map("logs")
}

model MemberLog {
  memberId  String
  logId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  log    logs   @relation(fields: [logId], references: [id], onDelete: Cascade)

  @@id([memberId, logId])
  @@map("member_logs")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  memberId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([memberId])
  @@index([token])
}

model SyncStatus {
  id           String    @id @default(uuid())
  entityType   String
  entityId     String
  lastSyncAt   DateTime?
  syncStatus   String
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  member  Member?  @relation("MemberSync", fields: [entityId], references: [id], onDelete: Cascade, map: "fk_syncstatus_member")
  role    Role?    @relation("RoleSync", fields: [entityId], references: [id], onDelete: Cascade, map: "fk_syncstatus_role")
  channel Channel? @relation("ChannelSync", fields: [entityId], references: [id], onDelete: Cascade, map: "fk_syncstatus_channel")
  project Project? @relation("ProjectSync", fields: [entityId], references: [id], onDelete: Cascade, map: "fk_syncstatus_project")

  @@unique([entityType, entityId])
  @@map("sync_statuses")
  @@index([entityType])
  @@index([syncStatus])
}

model MessageLog {
  id               String   @id @default(uuid())
  projectId        String
  channelId        String?
  messageType      String
  messageContent   String?  @db.Text
  discordMessageId String?
  sentAt           DateTime @default(now())
  sentBy           String?
  status           String   @default("sent")
  errorMessage     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  channel Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  sender  Member?  @relation("SentByMember", fields: [sentBy], references: [id], onDelete: SetNull)

  @@map("message_logs")
  @@index([projectId])
  @@index([channelId])
  @@index([sentAt])
}