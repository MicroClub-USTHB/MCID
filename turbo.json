{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  // loose: the API needs DATABASE_URL, DISCORD_*, REDIS_* etc. at runtime and in tests;
  // strict mode would have to allow-list every one of them per task.
  "envMode": "loose",
  "globalDependencies": [".prettierrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}
