{
  "name": "mcdi",
  "version": "0.0.1",
  "description": "",
  "packageManager": "pnpm@10.28.1",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.cjs --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:docker": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f /migrations/migration.sql",
    "db:studio": "drizzle-kit studio --host 0.0.0.0",
    "db:seed": "tsx src/database/seed.ts",
    "db:clear": "tsx src/database/clear.ts",
    "start:prod:migrate": "pnpm run db:migrate && node dist/main.js",
    "test:ci": "jest --json --outputFile=test-results.json --coverage --coverageReporters=json-summary",
    "lint:report": "eslint \"src/**/*.ts\" --format json --output-file=eslint-results.json || true",
    "issues:report": "tsx scripts/generate-issues.ts",
    "docker:up": "docker-compose up -d",
    "docker:up:build": "docker-compose up --build -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f api",
    "docker:restart": "docker-compose restart api",
    "docker:db:push": "docker-compose exec api pnpm run db:push",
    "docker:db:seed": "docker-compose exec api pnpm run db:seed",
    "docker:db:studio": "docker exec mcdi-api-1 sh -lc \"nohup pnpm dlx drizzle-kit studio --host 0.0.0.0 --port 4983 > /tmp/drizzle-studio.log 2>&1 < /dev/null &\" && sleep 2 && docker exec mcdi-api-1 sh -lc \"tail -n 20 /tmp/drizzle-studio.log\" && echo 'Drizzle Studio URL: https://local.drizzle.studio?host=localhost&port=4983'",
    "docker:db:studio:logs": "docker exec mcdi-api-1 sh -lc \"tail -f /tmp/drizzle-studio.log\"",
    "docker:db:studio:stop": "docker exec mcdi-api-1 sh -lc \"pkill -f 'drizzle-kit studio --host 0.0.0.0 --port 4983' 2>/dev/null || true\""
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@types/cookie-parser": "^1.4.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.25.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "ejs": "^4.0.1",
    "pg": "^8.18.0",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.14",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.11",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/nock": "^10.0.3",
    "@types/node": "^22.19.15",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.9",
    "eslint": "9.39.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "nock": "^14.0.11",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "5.1.6",
      "undici": ">=6.27.0",
      "ws": ">=8.21.0",
      "path-to-regexp": ">=8.1.0",
      "lodash": ">=4.17.21",
      "multer": ">=2.2.0",
      "form-data": ">=4.0.6",
      "picomatch": ">=4.0.4",
      "js-yaml": ">=4.2.0"
    }
  }
}
