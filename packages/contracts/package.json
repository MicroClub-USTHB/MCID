{
  "name": "@mcdi/contracts",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Types and constants shared by the API and the web app",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@mcdi/typescript-config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
